        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.AgriConnectMarket",
      "permissions": []
    },
    "extra": {
      "eas": {
        "projectId": "a295cf08-baaf-46fe-8982-0e220a27f57e"
      }
    }
